{
  "name": "civico-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor MCP somente leitura com os mesmos dados públicos do site (políticos, votos, cota).",
  "type": "module",
  "bin": {
    "civico-mcp": "dist/stdio.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "postgres": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
