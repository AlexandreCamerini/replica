# ---- web (Next.js) ----
# pg = Postgres real; vazio = dados de demonstração (proibido em produção sem ALLOW_DEMO_DATA=1)
DATA_SOURCE=pg
# Role web_reader via pooler do Supabase (modo transação). Local: postgres://web_reader:web_reader@localhost:54329/civico
DATABASE_URL=
PG_POOL_MAX=10
# Segredo do POST /api/revalidate (gere com: openssl rand -hex 32)
REVALIDATE_SECRET=
# Supabase Auth (R2): projeto criado pelo usuário
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Cloudflare Turnstile (R2)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Resend (R2)
RESEND_API_KEY=

# ---- etl (Python) ----
# Role de escrita (service_role no Supabase; postgres local). Nunca a mesma URL do web.
ETL_DATABASE_URL=
# Opcional: onde o ETL avisa o site que há dado novo
REVALIDATE_URL=http://localhost:3100/api/revalidate
# ETL_CACHE_DIR=etl/.cache  ETL_RATE_LIMIT=5  ETL_LOG=INFO
